<Window
    x:Class="AlarmAnalysisTool.Views.DateRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择导入时间范围"
    Width="480"
    Height="340"
    Background="#F0F0F0"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">
    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  说明文字  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontFamily="Microsoft YaHei UI"
            FontSize="13"
            Foreground="#555"
            TextWrapping="Wrap">
            数据库中数据时间范围如下，可选择导入全部或指定时间段的数据：
        </TextBlock>

        <!--  数据范围信息  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,20"
            Padding="15,10"
            Background="White"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.1"
                    ShadowDepth="1" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        Foreground="#888"
                        Text="最早记录: " />
                    <TextBlock
                        x:Name="MinDateText"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="--" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        Foreground="#888"
                        Text="最晚记录: " />
                    <TextBlock
                        x:Name="MaxDateText"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="--" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  全部导入按钮  -->
        <Button
            Grid.Row="2"
            x:Name="ImportAllButton"
            Margin="0,0,0,15"
            Padding="0,10"
            HorizontalAlignment="Stretch"
            Background="#4472C4"
            BorderThickness="0"
            Click="ImportAllButton_Click"
            Content="全部导入"
            Cursor="Hand"
            FontFamily="Microsoft YaHei UI"
            FontSize="14"
            FontWeight="Bold"
            Foreground="White">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3A5BA0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--  分隔线  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            FontFamily="Microsoft YaHei UI"
            FontSize="12"
            Foreground="#AAA"
            Text="—— 或者按时间范围筛选 ——" />

        <!--  日期选择  -->
        <Grid Grid.Row="4" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontFamily="Microsoft YaHei UI"
                FontSize="13"
                Foreground="#555"
                Text="开始: " />
            <DatePicker
                Grid.Column="1"
                x:Name="StartDatePicker"
                Margin="5,0,10,0"
                FontFamily="Microsoft YaHei UI"
                FontSize="13"
                SelectedDateFormat="Short" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Microsoft YaHei UI"
                FontSize="13"
                Foreground="#555"
                Text="结束: " />
            <DatePicker
                Grid.Column="3"
                x:Name="EndDatePicker"
                Margin="5,0,0,0"
                FontFamily="Microsoft YaHei UI"
                FontSize="13"
                SelectedDateFormat="Short" />
        </Grid>

        <!--  确认按钮  -->
        <Button
            Grid.Row="5"
            x:Name="ConfirmButton"
            Margin="0,10,0,0"
            Padding="0,10"
            HorizontalAlignment="Stretch"
            Background="#27AE60"
            BorderThickness="0"
            Click="ConfirmButton_Click"
            Content="按时间范围导入"
            Cursor="Hand"
            FontFamily="Microsoft YaHei UI"
            FontSize="14"
            FontWeight="Bold"
            Foreground="White">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E8449" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
