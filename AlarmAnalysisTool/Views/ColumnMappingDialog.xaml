<Window
    x:Class="AlarmAnalysisTool.Views.ColumnMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="列映射设置 - 自定义Excel导入"
    Width="800"
    Height="600"
    Background="#F5F5F5"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  说明  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="13"
            TextWrapping="Wrap">
            <Run FontWeight="Bold" Text="请将左侧的【标准字段】映射到右侧的【Excel列】。系统已自动检测，您可手动调整。" />
            <LineBreak />
            <Run Foreground="#666" Text="映射完成后点击确定即可导入数据。" />
        </TextBlock>

        <!--  映射设置  -->
        <Border
            Grid.Row="1"
            Padding="2"
            Background="White"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  表头  -->
                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="8,5"
                        Background="#4472C4">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="标准字段" />
                    </Border>
                    <Border Grid.Column="1" Background="#4472C4" />
                    <Border
                        Grid.Column="2"
                        Padding="8,5"
                        Background="#4472C4">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Excel列" />
                    </Border>
                </Grid>

                <!--  映射行  -->
                <ItemsControl x:Name="MappingList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Margin="0,0,2,0"
                                    Padding="8,6"
                                    Background="#E8EDF4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="0,6"
                                    Background="White">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="#4472C4"
                                        Text="→" />
                                </Border>
                                <ComboBox
                                    Grid.Column="2"
                                    Margin="2,0,0,0"
                                    Padding="6,4"
                                    ItemsSource="{Binding AvailableColumns}"
                                    SelectedItem="{Binding SelectedColumn, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!--  预览  -->
        <Expander
            Grid.Row="2"
            Margin="0,10,0,0"
            Header="数据预览（前5行）"
            IsExpanded="False">
            <Border
                MaxHeight="150"
                Background="White"
                CornerRadius="4">
                <DataGrid
                    x:Name="PreviewGrid"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    FontSize="11"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    IsReadOnly="True" />
            </Border>
        </Expander>

        <!--  按钮  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="AutoDetectBtn"
                Margin="0,0,10,0"
                Padding="20,8"
                Background="#5B9BD5"
                BorderThickness="0"
                Click="AutoDetectBtn_Click"
                Content="自动检测"
                FontWeight="Bold"
                Foreground="White" />
            <Button
                x:Name="CancelBtn"
                Margin="0,0,10,0"
                Padding="20,8"
                Click="CancelBtn_Click"
                Content="取消" />
            <Button
                x:Name="OkBtn"
                Padding="20,8"
                Background="#4472C4"
                BorderThickness="0"
                Click="OkBtn_Click"
                Content="确定导入"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
