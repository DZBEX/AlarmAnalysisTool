<Window
    x:Class="AlarmAnalysisTool.Views.FtpConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FTP远程采集配置"
    Width="850"
    Height="600"
    Background="#F0F0F0"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="DlgButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="15">
        <!--  底部按钮区  -->
        <Border
            Padding="0,10,0,0"
            Background="Transparent"
            DockPanel.Dock="Bottom">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="TestAllButton"
                    Background="#17A2B8"
                    Click="TestAllButton_Click"
                    Content="🔌 测试全部连接"
                    Foreground="White"
                    Style="{StaticResource DlgButton}" />
                <Button
                    x:Name="ImportButton"
                    Background="#27AE60"
                    Click="ImportButton_Click"
                    Content="📡 立即采集"
                    Foreground="White"
                    Style="{StaticResource DlgButton}" />
                <Button
                    x:Name="CloseButton"
                    Margin="10,0,0,0"
                    Background="#95A5A6"
                    Click="CloseButton_Click"
                    Content="关闭"
                    Foreground="White"
                    Style="{StaticResource DlgButton}" />
            </StackPanel>
        </Border>

        <!--  自动采集设置  -->
        <Border
            Margin="0,10,0,10"
            Padding="15,10"
            Background="White"
            CornerRadius="6"
            DockPanel.Dock="Bottom">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.1"
                    ShadowDepth="1" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="自动采集设置:" />
                <CheckBox
                    x:Name="AutoRefreshCheckBox"
                    Margin="15,0,5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Content="启用自动采集" />
                <TextBlock
                    Margin="15,0,5,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#555"
                    Text="采集间隔:" />
                <ComboBox
                    x:Name="IntervalComboBox"
                    Width="80"
                    VerticalAlignment="Center"
                    FontSize="13"
                    SelectedIndex="2">
                    <ComboBoxItem Content="1 分钟" />
                    <ComboBoxItem Content="2 分钟" />
                    <ComboBoxItem Content="5 分钟" />
                    <ComboBoxItem Content="10 分钟" />
                    <ComboBoxItem Content="15 分钟" />
                    <ComboBoxItem Content="30 分钟" />
                    <ComboBoxItem Content="60 分钟" />
                </ComboBox>
                <TextBlock
                    x:Name="LastSyncTextBlock"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#888"
                    Text="" />
            </StackPanel>
        </Border>

        <!--  快速添加区  -->
        <Border
            Margin="0,0,0,10"
            Padding="15,10"
            Background="White"
            CornerRadius="6"
            DockPanel.Dock="Top">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.1"
                    ShadowDepth="1" />
            </Border.Effect>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="快速添加（自定义名称 + FTP地址）" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  第1行：名称  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,8"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#555"
                        Text="服务器名称:" />
                    <TextBox
                        x:Name="ServerNameInputBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Padding="8,5"
                        FontSize="13"
                        ToolTip="自定义名称，将作为主页面实时报警表标题，如：1号线主控HMI" />
                    <Button
                        x:Name="AddManualButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="5,0,0,8"
                        Padding="15,5"
                        Background="#5B9BD5"
                        Click="AddManualButton_Click"
                        Content="手动添加"
                        Cursor="Hand"
                        FontSize="13"
                        Foreground="White" />

                    <!--  第2行：FTP地址  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#555"
                        Text="FTP地址:" />
                    <TextBox
                        x:Name="UrlInputBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="8,5"
                        FontSize="13"
                        ToolTip="格式: ftp://用户名:密码@主机地址/路径/文件.db" />
                    <Button
                        x:Name="AddFromUrlButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        Padding="15,5"
                        Background="#4472C4"
                        Click="AddFromUrlButton_Click"
                        Content="从URL添加"
                        Cursor="Hand"
                        FontSize="13"
                        Foreground="White" />
                </Grid>
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="11"
                    Foreground="#999"
                    Text="名称将作为主页面&quot;xxx实时报警&quot;表标题。示例: ftp://uploadhis:111111@192.168.250.4/eventlog/event.db"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  配置列表  -->
        <Border
            Padding="10"
            Background="White"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.1"
                    ShadowDepth="1" />
            </Border.Effect>
            <DockPanel>
                <TextBlock
                    Margin="5,0,0,8"
                    DockPanel.Dock="Top"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="已配置的FTP服务器" />

                <!--  操作按钮  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        x:Name="TestSelectedButton"
                        Margin="3,5"
                        Padding="12,5"
                        Background="#17A2B8"
                        Click="TestSelectedButton_Click"
                        Content="测试选中"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="White" />
                    <Button
                        x:Name="DeleteButton"
                        Margin="3,5"
                        Padding="12,5"
                        Background="#E74C3C"
                        Click="DeleteButton_Click"
                        Content="删除选中"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="White" />
                </StackPanel>

                <DataGrid
                    x:Name="ConfigDataGrid"
                    Margin="0,0,0,5"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    FontSize="12"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    RowHeight="30"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Width="45"
                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                            Header="启用" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            Header="名称" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                            Header="主机地址" />
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                            Header="端口" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            Header="用户名" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                            Header="密码" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}"
                            Header="远程路径" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding LastSyncText}"
                            Header="最后同步"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
