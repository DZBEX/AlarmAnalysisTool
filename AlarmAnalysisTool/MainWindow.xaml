<Window
    x:Class="AlarmAnalysisTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:AlarmAnalysisTool.Models"
    xmlns:oxy="http://oxyplot.org/wpf"
    Title="XYR-威纶通HMI报警日志分析工具"
    Width="1400"
    Height="850"
    AllowsTransparency="True"
    Background="#F0F0F0"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None">
    <Window.Resources>
        <!--  Bool转Visibility  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!--  统一按钮样式  -->
        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--  统一左侧面板按钮样式  -->
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--  统一卡片样式  -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="8"
                        Opacity="0.15"
                        ShadowDepth="1"
                        Color="#333" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  统一图表卡片样式  -->
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="6"
                        Opacity="0.1"
                        ShadowDepth="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  统一表格表头样式  -->
        <!--  DataGrid 单元格文字水平居中样式  -->
        <Style x:Key="DataGridCenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4472C4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!--  统一工具栏样式  -->
        <Style x:Key="ToolBarStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="4"
                        Direction="270"
                        Opacity="0.08"
                        ShadowDepth="1" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  统一左侧面板样式  -->
        <Style x:Key="SidePanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!--  统一节标题样式  -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  统一标签样式  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#888" />
        </Style>

        <!--  标题栏渐变背景  -->
        <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#4472C4" />
            <GradientStop Offset="1" Color="#2C3E50" />
        </LinearGradientBrush>

        <!--  标题栏窗口控制按钮样式（深色渐变背景上的浅色按钮）  -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#ECF0F1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F6Db0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3A5388" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  关闭按钮独立样式（红色 hover/按下，自包含以避免 BasedOn 触发器优先级问题）  -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#ECF0F1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E74C3C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C0392B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  诊断级别颜色  -->
        <Style x:Key="SuggestionLevelCritical" TargetType="Border">
            <Setter Property="Background" Value="#FFC7CE" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="SuggestionLevelWarning" TargetType="Border">
            <Setter Property="Background" Value="#FFEB9C" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="SuggestionLevelInfo" TargetType="Border">
            <Setter Property="Background" Value="#C6EFCE" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--  顶部标题栏（兼窗体标题栏）  -->
        <Border
            x:Name="TitleBar"
            Height="40"
            Background="{StaticResource TitleBarGradient}"
            DockPanel.Dock="Top"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="2" />
            </Border.Effect>
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左侧：Logo + 标题 + 状态  -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center">
                    <!--  应用图标（柱状图风格）  -->
                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,9,0"
                        Background="White"
                        CornerRadius="5"
                        DockPanel.Dock="Left">
                        <Canvas
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Rectangle
                                Canvas.Left="1"
                                Canvas.Top="8"
                                Width="3"
                                Height="6"
                                Fill="#4472C4"
                                RadiusX="1"
                                RadiusY="1" />
                            <Rectangle
                                Canvas.Left="5.5"
                                Canvas.Top="4"
                                Width="3"
                                Height="10"
                                Fill="#4472C4"
                                RadiusX="1"
                                RadiusY="1" />
                            <Rectangle
                                Canvas.Left="10"
                                Canvas.Top="1"
                                Width="3"
                                Height="13"
                                Fill="#4472C4"
                                RadiusX="1"
                                RadiusY="1" />
                        </Canvas>
                    </Border>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14.5"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="XYR · 威纶通HMI报警日志智能分析工具" />
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="White"
                        Text="{Binding StatusText}" />


                </DockPanel>

                <!--  右侧：窗口控制按钮  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        x:Name="MinimizeButton"
                        Click="MinimizeButton_Click"
                        Content="─"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        Content="□"
                        Style="{StaticResource TitleBarButton}" />
                    <Button
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Content="✕"
                        Style="{StaticResource TitleBarCloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  顶层工作区切换  -->
        <TabControl
            Padding="0"
            Background="#F0F0F0"
            BorderThickness="0"
            TabStripPlacement="Top">

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  工作区1: 实时采集监控  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <TabItem
                Padding="20,8"
                FontSize="14"
                FontWeight="Bold"
                Header="📡 实时采集监控">
                <DockPanel>
                    <!--  FTP工具栏  -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource ToolBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#17A2B8"
                                Text="实时采集:" />
                            <Button
                                Background="#17A2B8"
                                Command="{Binding ImportFromFtpCommand}"
                                Content="🌐 立即采集"
                                Foreground="White"
                                IsEnabled="{Binding IsNotFtpBusy}"
                                Style="{StaticResource ToolBarButton}" />
                            <Button
                                Background="#6C757D"
                                Command="{Binding ManageFtpConfigsCommand}"
                                Content="⚙️ FTP配置"
                                Foreground="White"
                                Style="{StaticResource ToolBarButton}" />
                            <Separator Margin="10,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#888"
                                Text="自动采集:" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#27AE60"
                                Text="● 已启用"
                                Visibility="{Binding IsAutoRefreshEnabled, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#999"
                                Text="○ 未启用"
                                Visibility="{Binding IsNotAutoRefreshEnabled, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧: FTP采集状态  -->
                        <Border Grid.Column="0" Style="{StaticResource SidePanelStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#17A2B8"
                                        Style="{StaticResource SectionTitle}"
                                        Text="采集状态" />

                                    <!--  采集状态卡片  -->
                                    <Border
                                        Margin="0,0,0,15"
                                        Padding="10,8"
                                        Background="#E8F6F3"
                                        BorderBrush="#17A2B8"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#17A2B8"
                                                Text="最后采集" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="#555"
                                                Text="{Binding FtpSyncStatus}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!--  实时报警表数量  -->
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="监控服务器数:" />
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#17A2B8"
                                            Text="{Binding RealtimeTables.Count}" />
                                    </StackPanel>

                                    <!--  服务器列表  -->
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#333"
                                        Text="服务器列表" />
                                    <ItemsControl ItemsSource="{Binding RealtimeTables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,5"
                                                    Padding="8,6"
                                                    Background="#F8F9FA"
                                                    CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,6,0"
                                                            Fill="{Binding StatusColor}" />
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="Medium"
                                                                Text="{Binding ServerName}" />
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="#999"
                                                                Text="{Binding StatusSummary}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  空状态提示  -->
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="11"
                                        Foreground="#999"
                                        Text="尚未配置FTP服务器。点击上方&quot;FTP配置&quot;添加服务器开始实时监控。"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsNotFtpConfigured, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!--  右侧: 实时报警表  -->
                        <ScrollViewer
                            Grid.Column="1"
                            Margin="8"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  空状态  -->
                                <Border
                                    Margin="20"
                                    Padding="40"
                                    Background="White"
                                    CornerRadius="8"
                                    Visibility="{Binding IsNotRealtimeTables, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock
                                            Margin="0,10,0,5"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#555"
                                            Text="暂无实时报警数据" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#999"
                                            Text="请配置FTP服务器并点击&quot;立即采集&quot;开始监控" />
                                    </StackPanel>
                                </Border>

                                <!--  实时报警表列表  -->
                                <ItemsControl ItemsSource="{Binding RealtimeTables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="5,5,5,10"
                                                Padding="12"
                                                Background="White"
                                                CornerRadius="6">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Opacity="0.1"
                                                        ShadowDepth="1" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <!--  表头：服务器名称 + 状态  -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Ellipse
                                                                Width="10"
                                                                Height="10"
                                                                Margin="0,0,8,0"
                                                                Fill="{Binding StatusColor}" />
                                                            <TextBlock
                                                                FontSize="15"
                                                                FontWeight="Bold"
                                                                Foreground="#333"
                                                                Text="{Binding TableTitle}" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="#888"
                                                            Text="{Binding StatusSummary}" />

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="#999"
                                                            Text="{Binding FtpHost}" />
                                                    </Grid>

                                                    <!--  新增报警提示  -->
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="8,4"
                                                        Background="#FFF3E0"
                                                        BorderBrush="#FF9800"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Visibility="{Binding HasNewAlarms, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#E65100"
                                                            Text="{Binding NewAlarmCount, StringFormat=本次新增 {0} 条报警}" />
                                                    </Border>

                                                    <!--  报警数据表  -->
                                                    <DataGrid
                                                        MaxHeight="350"
                                                        AlternatingRowBackground="#F7F9FC"
                                                        AutoGenerateColumns="False"
                                                        CanUserAddRows="False"
                                                        CanUserSortColumns="True"
                                                        ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                                        FontSize="12"
                                                        GridLinesVisibility="Horizontal"
                                                        HeadersVisibility="Column"
                                                        IsReadOnly="True"
                                                        ItemsSource="{Binding Records}"
                                                        RowHeight="26">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn
                                                                Width="150"
                                                                Binding="{Binding TriggerDateTimeText}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="触发时间" />
                                                            <DataGridTextColumn
                                                                Width="65"
                                                                Binding="{Binding AlarmCode}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="报警码" />
                                                            <DataGridTextColumn
                                                                Width="200*"
                                                                MinWidth="120"
                                                                Binding="{Binding Description}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="报警描述" />
                                                            <DataGridTextColumn
                                                                Width="120"
                                                                Binding="{Binding CategoryName}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="类别" />
                                                            <DataGridTextColumn
                                                                Width="80"
                                                                Binding="{Binding Source}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="来源" />
                                                            <DataGridTextColumn
                                                                Width="85"
                                                                Binding="{Binding DurationText}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="持续" />
                                                            <DataGridTextColumn
                                                                Width="50"
                                                                Binding="{Binding RecoveredText}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="恢复" />
                                                            <DataGridTextColumn
                                                                Width="60"
                                                                Binding="{Binding OccurrenceCount}"
                                                                ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                                Header="次数" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!--  ═══════════════════════════════════════════════════  -->
            <!--  工作区2: 历史报警分析  -->
            <!--  ═══════════════════════════════════════════════════  -->
            <TabItem
                Padding="20,8"
                FontSize="14"
                FontWeight="Bold"
                Header="📊 历史报警分析">
                <DockPanel>
                    <!--  导入/导出工具栏  -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource ToolBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  导入按钮组  -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#4472C4"
                                    Text="导入:" />
                                <Button
                                    Background="#5B9BD5"
                                    Command="{Binding ImportCsvCommand}"
                                    Content="📂 CSV文件"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                                <Button
                                    Background="#70AD47"
                                    Command="{Binding ImportExcelCommand}"
                                    Content="📊 Excel文件"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                                <Button
                                    Background="#7030A0"
                                    Command="{Binding ImportSqliteCommand}"
                                    Content="🗄️ 数据库文件"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                            </StackPanel>

                            <!--  导出按钮组  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#ED7D31"
                                    Text="导出:" />
                                <Button
                                    Background="#ED7D31"
                                    Command="{Binding ExportExcelCommand}"
                                    Content="📋 完整报告(Excel)"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                                <Button
                                    Background="#E74C3C"
                                    Command="{Binding ExportPdfCommand}"
                                    Content="📄 PDF报告"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                                <Button
                                    Background="#2E86C1"
                                    Command="{Binding ExportWordCommand}"
                                    Content="📝 Word报告"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                                <Button
                                    Background="#FFC000"
                                    Command="{Binding ExportCsvCommand}"
                                    Content="📋 原始数据(CSV)"
                                    Foreground="White"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource ToolBarButton}" />
                            </StackPanel>

                            <!--  重新分析  -->
                            <Button
                                Grid.Column="3"
                                Background="#4472C4"
                                Command="{Binding AnalyzeCommand}"
                                Content="🔄 重新分析"
                                Foreground="White"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource ToolBarButton}" />
                        </Grid>
                    </Border>

                    <!--  主内容区  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧面板  -->
                        <Border Grid.Column="0" Style="{StaticResource SidePanelStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!--  文件信息  -->
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="文件信息" />

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="文件名:" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Text="{Binding FileInfo.FileNameDisplay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="记录数:" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#4472C4"
                                            Text="{Binding FileInfo.RecordCount}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="文件数:" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#70AD47"
                                            Text="{Binding FileInfo.FileCount}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="时间范围:" />
                                        <TextBlock
                                            FontSize="11"
                                            Text="{Binding FileInfo.DateRange}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="导入时间:" />
                                        <TextBlock FontSize="11" Text="{Binding FileInfo.ImportTime, StringFormat=yyyy-MM-dd HH:mm}" />
                                    </StackPanel>

                                    <Separator Margin="0,5,0,15" />

                                    <!--  筛选  -->
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="数据筛选" />

                                    <!--  时间段筛选  -->
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        Style="{StaticResource FieldLabel}"
                                        Text="开始日期:" />
                                    <DatePicker
                                        Margin="0,0,5,8"
                                        Padding="5,3"
                                        SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" />

                                    <TextBlock
                                        Margin="0,0,0,3"
                                        Style="{StaticResource FieldLabel}"
                                        Text="结束日期:" />
                                    <DatePicker
                                        Margin="0,0,5,10"
                                        Padding="5,3"
                                        SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" />

                                    <!--  报警类别多选  -->
                                    <Grid Margin="0,0,5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="报警类别:" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            Background="#4472C4"
                                            BorderThickness="0"
                                            Command="{Binding ToggleAllCategoriesCommand}"
                                            Content="全选/取消"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="White" />
                                    </Grid>
                                    <Border
                                        MaxHeight="120"
                                        Margin="0,0,5,10"
                                        BorderBrush="#DDD"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox
                                                            Margin="5,2"
                                                            Content="{Binding Name}"
                                                            FontSize="12"
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!--  设备来源多选  -->
                                    <Grid Margin="0,0,5,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="设备来源:" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            Background="#4472C4"
                                            BorderThickness="0"
                                            Command="{Binding ToggleAllSourcesCommand}"
                                            Content="全选/取消"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="White" />
                                    </Grid>
                                    <Border
                                        MaxHeight="120"
                                        Margin="0,0,5,10"
                                        BorderBrush="#DDD"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableSources}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox
                                                            Margin="5,2"
                                                            Content="{Binding Name}"
                                                            FontSize="12"
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!--  关键字  -->
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        Style="{StaticResource FieldLabel}"
                                        Text="关键字:" />
                                    <TextBox
                                        Margin="0,0,5,10"
                                        Padding="5,3"
                                        Text="{Binding FilterKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Margin="0,0,5,10"
                                        Background="#4472C4"
                                        Command="{Binding ApplyFilterCommand}"
                                        Content="筛选"
                                        Foreground="White"
                                        Style="{StaticResource SideButton}" />
                                    <Button
                                        Margin="0,0,5,10"
                                        Background="#95A5A6"
                                        Command="{Binding ClearFilterCommand}"
                                        Content="清除"
                                        Foreground="White"
                                        Style="{StaticResource SideButton}" />

                                    <Separator Margin="0,15,0,15" />

                                    <!--  概览摘要  -->
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="分析概览" />

                                    <!--  提示类过滤提示  -->
                                    <Border
                                        Margin="0,0,5,10"
                                        Padding="8,6"
                                        Background="#FFF8E1"
                                        BorderBrush="#FFE082"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding HasFilteredInfo, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#E65100"
                                                Text="已过滤提示类记录" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#E65100"
                                                Text="{Binding FilteredInfoSummary}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="总报警数:" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding Summary.TotalAlarms}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="分析天数:" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#70AD47"
                                            Text="{Binding Summary.DayCount}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="报警类型:" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding Summary.UniqueAlarmTypes}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="未恢复报警:" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="#ED7D31"
                                            Text="{Binding Summary.UnrecoveredCount}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="累计持续:" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Text="{Binding Summary.TotalDurationText}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!--  右侧Tab区域  -->
                        <TabControl
                            Grid.Column="1"
                            Margin="8"
                            Padding="0"
                            Background="White">

                            <!--  Tab1: 原始数据  -->
                            <TabItem
                                Padding="15,5"
                                FontSize="13"
                                Header="📋 原始数据">
                                <DataGrid
                                    AlternatingRowBackground="#F7F9FC"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserSortColumns="True"
                                    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                    FontSize="12"
                                    GridLinesVisibility="Horizontal"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding FilteredRecords}"
                                    RowHeight="28"
                                    SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="60"
                                            Binding="{Binding EventType}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="事件" />
                                        <DataGridTextColumn
                                            Width="130"
                                            Binding="{Binding CategoryName}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="类别" />
                                        <DataGridTextColumn
                                            Width="150"
                                            Binding="{Binding TriggerDateTimeText}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="触发时间" />
                                        <DataGridTextColumn
                                            Width="150"
                                            Binding="{Binding RecoveryDateTimeText}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="恢复时间" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding DurationText}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="持续" />
                                        <DataGridTextColumn
                                            Width="65"
                                            Binding="{Binding AlarmCode}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="报警码" />
                                        <DataGridTextColumn
                                            Width="200*"
                                            MinWidth="120"
                                            Binding="{Binding Description}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="报警描述" />
                                        <DataGridTextColumn
                                            Width="230"
                                            Binding="{Binding Source}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="来源" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding OccurrenceCount}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="发生次数" />
                                        <DataGridTextColumn
                                            Width="50"
                                            Binding="{Binding RecoveredText}"
                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                            Header="恢复" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <!--  Tab2: 智能分析  -->
                            <TabItem
                                Padding="15,5"
                                FontSize="13"
                                Header="📊 智能分析">
                                <ScrollViewer Padding="5" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!--  摘要卡片  -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Border Width="180" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="总报警数" />
                                                    <TextBlock
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="#4472C4"
                                                        Text="{Binding Summary.TotalAlarms}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Width="180" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="分析天数" />
                                                    <TextBlock
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="#70AD47"
                                                        Text="{Binding Summary.DayCount}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Width="180" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="报警类型" />
                                                    <TextBlock
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="#70AD47"
                                                        Text="{Binding Summary.UniqueAlarmTypes}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Width="180" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="未恢复报警" />
                                                    <TextBlock
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="#ED7D31"
                                                        Text="{Binding Summary.UnrecoveredCount}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Width="180" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="设备来源" />
                                                    <TextBlock
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="#FFC000"
                                                        Text="{Binding Summary.SourceCount}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Width="220" Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#888"
                                                        Text="最高频报警" />
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Text="{Binding Summary.TopAlarm}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#ED7D31"
                                                        Text="{Binding Summary.TopAlarmCount, StringFormat={}{0} 次}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <!--  图表区域 3行  -->
                                        <Grid Margin="0,5,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  频次图表  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Height="380"
                                                Style="{StaticResource ChartCard}">
                                                <oxy:PlotView
                                                    Background="White"
                                                    Model="{Binding FrequencyChart}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    RenderOptions.CachingHint="Cache"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True" />
                                            </Border>

                                            <!--  类别分布饼图  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="380"
                                                Style="{StaticResource ChartCard}">
                                                <oxy:PlotView
                                                    Background="White"
                                                    Model="{Binding CategoryChart}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    RenderOptions.CachingHint="Cache"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True" />
                                            </Border>

                                            <!--  时间分布柱状图  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Height="340"
                                                Style="{StaticResource ChartCard}">
                                                <oxy:PlotView
                                                    Background="White"
                                                    Model="{Binding HourlyChart}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    RenderOptions.CachingHint="Cache"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True" />
                                            </Border>

                                            <!--  设备来源柱状图  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Height="340"
                                                Style="{StaticResource ChartCard}">
                                                <oxy:PlotView
                                                    Background="White"
                                                    Model="{Binding SourceChart}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    RenderOptions.CachingHint="Cache"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True" />
                                            </Border>

                                            <!--  按日趋势图（整行，高度自适应天数）  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Height="{Binding DailyChartHeight}"
                                                Style="{StaticResource ChartCard}">
                                                <oxy:PlotView
                                                    Background="White"
                                                    Model="{Binding DailyChart}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    RenderOptions.CachingHint="Cache"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True" />
                                            </Border>
                                        </Grid>

                                        <!--  频次排行表格  -->
                                        <Border
                                            Margin="5,10,5,5"
                                            Padding="10"
                                            Background="White"
                                            CornerRadius="6">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.1"
                                                    ShadowDepth="1" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,8"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Text="报警频次排行" />
                                                <DataGrid
                                                    MaxHeight="250"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                                    FontSize="12"
                                                    GridLinesVisibility="Horizontal"
                                                    HeadersVisibility="Column"
                                                    IsReadOnly="True"
                                                    ItemsSource="{Binding FrequencyData}"
                                                    RowHeight="26">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="50"
                                                            Binding="{Binding Rank}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="排名" />
                                                        <DataGridTextColumn
                                                            Width="65"
                                                            Binding="{Binding AlarmCode}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警码" />
                                                        <DataGridTextColumn
                                                            Width="200*"
                                                            MinWidth="120"
                                                            Binding="{Binding Description}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警描述" />
                                                        <DataGridTextColumn
                                                            Width="130"
                                                            Binding="{Binding CategoryName}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="类别" />
                                                        <DataGridTextColumn
                                                            Width="80"
                                                            Binding="{Binding Source}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="来源" />
                                                        <DataGridTextColumn
                                                            Width="60"
                                                            Binding="{Binding Count}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="次数" />
                                                        <DataGridTextColumn
                                                            Width="60"
                                                            Binding="{Binding Percentage, StringFormat={}{0:F1}}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="占比%" />
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding TotalDurationText}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="累计持续" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!--  持续时间分析表格  -->
                                        <Border
                                            Margin="5,10,5,5"
                                            Padding="10"
                                            Background="White"
                                            CornerRadius="6">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.1"
                                                    ShadowDepth="1" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,8"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Text="持续时间分析" />
                                                <DataGrid
                                                    MaxHeight="250"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                                    FontSize="12"
                                                    GridLinesVisibility="Horizontal"
                                                    HeadersVisibility="Column"
                                                    IsReadOnly="True"
                                                    ItemsSource="{Binding DurationData}"
                                                    RowHeight="26">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="65"
                                                            Binding="{Binding AlarmCode}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警码" />
                                                        <DataGridTextColumn
                                                            Width="200*"
                                                            MinWidth="120"
                                                            Binding="{Binding Description}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警描述" />
                                                        <DataGridTextColumn
                                                            Width="70"
                                                            Binding="{Binding Occurrences}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="触发次数" />
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding MaxDurationText}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="最长持续" />
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding AvgDurationText}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="平均持续" />
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding TotalDurationText}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="累计持续" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!--  按日趋势数据表格  -->
                                        <Border
                                            Margin="5,10,5,5"
                                            Padding="10"
                                            Background="White"
                                            CornerRadius="6">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.1"
                                                    ShadowDepth="1" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,8"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Text="按日报警趋势" />
                                                <DataGrid
                                                    MaxHeight="250"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                                    FontSize="12"
                                                    GridLinesVisibility="Horizontal"
                                                    HeadersVisibility="Column"
                                                    IsReadOnly="True"
                                                    ItemsSource="{Binding DailyData}"
                                                    RowHeight="26">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding DateFullText}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="日期" />
                                                        <DataGridTextColumn
                                                            Width="60"
                                                            Binding="{Binding DayOfWeek}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="星期" />
                                                        <DataGridTextColumn
                                                            Width="80"
                                                            Binding="{Binding Count}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警次数" />
                                                        <DataGridTextColumn
                                                            Width="80"
                                                            Binding="{Binding UniqueAlarmTypes}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="报警类型数" />
                                                        <DataGridTextColumn
                                                            Width="80"
                                                            Binding="{Binding UnrecoveredCount}"
                                                            ElementStyle="{StaticResource DataGridCenteredCellStyle}"
                                                            Header="未恢复数" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--  Tab3: 智能诊断  -->
                            <TabItem
                                Padding="15,5"
                                FontSize="13"
                                Header="🤖 智能诊断">
                                <ScrollViewer Padding="5" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="5,5,0,10"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#333"
                                            Text="智能诊断建议" />
                                        <TextBlock
                                            Margin="5,0,0,15"
                                            FontSize="12"
                                            Foreground="#888"
                                            Text="基于报警频次、持续时间、关联模式、时间分布等多维度分析，自动生成的诊断建议。"
                                            TextWrapping="Wrap" />

                                        <ItemsControl Margin="5,0" ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,10"
                                                        Padding="15"
                                                        Background="White"
                                                        CornerRadius="6">
                                                        <Border.Effect>
                                                            <DropShadowEffect
                                                                BlurRadius="6"
                                                                Opacity="0.1"
                                                                ShadowDepth="1" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                                                <Border
                                                                    Margin="0,0,10,0"
                                                                    Padding="6,2"
                                                                    CornerRadius="3">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#C6EFCE" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LevelText}" Value="严重">
                                                                                    <Setter Property="Background" Value="#FFC7CE" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LevelText}" Value="警告">
                                                                                    <Setter Property="Background" Value="#FFEB9C" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="Bold"
                                                                        Text="{Binding LevelText}" />
                                                                </Border>
                                                                <TextBlock
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="#333"
                                                                    Text="{Binding Title}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Margin="0,0,0,8"
                                                                FontSize="12"
                                                                Foreground="#555"
                                                                Text="{Binding Description}"
                                                                TextWrapping="Wrap" />
                                                            <Border
                                                                Padding="10,8"
                                                                Background="#F5F7FA"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontFamily="Consolas"
                                                                    FontSize="12"
                                                                    Foreground="#444"
                                                                    Text="{Binding Detail}"
                                                                    TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!--  Tab4: 关联分析  -->
                            <TabItem
                                Padding="15,5"
                                FontSize="13"
                                Header="🔗 关联分析">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,5"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="报警关联分析" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,25,0,15"
                                        FontSize="12"
                                        Foreground="#888"
                                        Text="检测在2分钟时间窗口内同时出现的报警对，揭示报警之间的共现关系。消除根因可同时减少多个报警。"
                                        TextWrapping="Wrap" />

                                    <Border
                                        Grid.Row="1"
                                        Padding="10"
                                        Background="White"
                                        CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Opacity="0.1"
                                                ShadowDepth="1" />
                                        </Border.Effect>
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            FontSize="12"
                                            GridLinesVisibility="Horizontal"
                                            HeadersVisibility="Column"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding CorrelationData}"
                                            RowHeight="28">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="250*"
                                                    MinWidth="150"
                                                    Binding="{Binding Alarm1}"
                                                    Header="报警1" />
                                                <DataGridTextColumn
                                                    Width="250*"
                                                    MinWidth="150"
                                                    Binding="{Binding Alarm2}"
                                                    Header="报警2" />
                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding CoOccurrenceCount}"
                                                    Header="共现次数" />
                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding Confidence, StringFormat={}{0:F1}}"
                                                    Header="置信度%" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!--  未恢复报警  -->
                                    <Border
                                        Grid.Row="2"
                                        MaxHeight="300"
                                        Margin="0,10,0,0"
                                        Padding="10"
                                        Background="White"
                                        CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Opacity="0.1"
                                                ShadowDepth="1" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#ED7D31"
                                                Text="未恢复报警列表" />
                                            <DataGrid
                                                MaxHeight="200"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                                FontSize="12"
                                                GridLinesVisibility="Horizontal"
                                                HeadersVisibility="Column"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding UnrecoveredData}"
                                                RowHeight="26">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Width="150"
                                                        Binding="{Binding TriggerDateTimeText}"
                                                        Header="触发时间" />
                                                    <DataGridTextColumn
                                                        Width="65"
                                                        Binding="{Binding AlarmCode}"
                                                        Header="报警码" />
                                                    <DataGridTextColumn
                                                        Width="200*"
                                                        MinWidth="120"
                                                        Binding="{Binding Description}"
                                                        Header="报警描述" />
                                                    <DataGridTextColumn
                                                        Width="100"
                                                        Binding="{Binding Source}"
                                                        Header="来源" />
                                                    <DataGridTextColumn
                                                        Width="70"
                                                        Binding="{Binding OccurrenceCount}"
                                                        Header="发生次数" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
